# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_GUILD_ID=

# YouTube / Google OAuth (write access needs OAuth, not just an API key)
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URL=http://localhost:50770/oauth/callback

# Admin UI
ADMIN_PASSWORD=change-me-please
# Optional: Basic Auth user "api" for Streamer.bot broadcast fire GETs
API_PASSWORD=
ADMIN_PORT=50770
ADMIN_HOST=0.0.0.0

# Database (SQLite file; created in Phase 1)
DATABASE_PATH=./data/subotto.db

# Optional
LOG_LEVEL=info
RESYNC_INTERVAL_HOURS=0
