# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_GUILD_ID=

# YouTube / Google OAuth (write access needs OAuth, not just an API key)
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
# PROD: set this to the public HTTPS callback (must match Google Console exactly), e.g. https://subotto.example.com/oauth/callback
YOUTUBE_REDIRECT_URL=http://localhost:50770/oauth/callback

# Admin UI
ADMIN_PASSWORD=change-me-please
# Optional: Basic Auth user "api" for Streamer.bot broadcast fire GETs
API_PASSWORD=
ADMIN_PORT=50770
ADMIN_HOST=0.0.0.0

# Database (SQLite file; created in Phase 1)
DATABASE_PATH=./data/subotto.db

# Optional
LOG_LEVEL=info
# Bootstrap only until Admin → Scheduler is saved (0 = off).
RESYNC_INTERVAL_HOURS=0

# Hesh Helper (OpenRouter). Empty key = AI off; bot still runs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
