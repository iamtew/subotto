# Secrets — never commit real tokens
.env

# Build output
bin/
dist/

# SQLite runtime DB (keep data/.gitkeep tracked)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Picture listener gallery files (keep data/pictures/.gitkeep)
data/pictures/**
!data/pictures/.gitkeep

# OAuth / token files Clanker may write later
data/token.json
data/youtube-token.json
*.token.json

# Go
vendor/

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Editor / IDE
.idea/
.vscode/
*.swp
*~
